# MBON Dashboard API settings. Copy to api/.env (run.sh does this for you).
# Real environment variables override anything set here.

# --- default Postgres source (see deploy/compose.yml for a local instance) ---
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=change-me

# --- server ---
API_HOST=127.0.0.1          # use 0.0.0.0 only behind a firewall / reverse proxy
API_PORT=5050
FLASK_DEBUG=0               # never enable on a shared network
# Extra allowed browser origins (comma-separated), e.g. your dashboard host
CORS_ORIGINS=

# --- data / limits ---
TAXDUMP_DIR=taxdump         # NCBI names.dmp + nodes.dmp (relative to repo root)
SQL_MAX_ROWS=5000
SQL_TIMEOUT_MS=15000
MAX_CONTENT_MB=64

# --- logging ---
LOG_LEVEL=INFO
LOG_FILE=                   # default: logs/api.log ; '-' disables file logging

# Frontend: make-config.sh reads this to write frontend/config.js
API_URL=http://127.0.0.1:5050/api
