# Settings for ingest.py / build_mbon_html.py. Copy to .env in the repo root.
# Real environment variables override anything set here.

# Postgres used by ingest.py (matches deploy/compose.yml for local dev)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=change-me

# Optional overrides (defaults are folders inside this repo)
# EDNA_PROJECTS_DIR=data/projects
# EDNA_SKIP_RUNS=run_a,run_b          # build_mbon_html.py: leave these runs out
# EDNA_SKIP_FOLDERS=old_results       # build_mbon_html.py --include-unmanifested
# EDNA_INGEST_USER=postgres           # recorded_by / entered_by in the DB
# EDNA_LOG_LEVEL=INFO
# EDNA_LOG_FILE=logs/custom.log
